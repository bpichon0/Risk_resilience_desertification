@article{ WOS:A1995RF90300001,
Author = {KASSAS, M},
Title = {DESERTIFICATION - A GENERAL-REVIEW},
Journal = {JOURNAL OF ARID ENVIRONMENTS},
Year = {1995},
Volume = {30},
Number = {2},
Pages = {115-128},
Month = {JUN},
Abstract = {This review paper provides explanation and global assessment of
   desertification as it menaces the world drylands. It shows the
   differences between drought (a natural hazard) and desertification
   (degradation of land resources), and quotes an example of management of
   drought (Syria case study) and an example of management of
   desertification (case study of U.S.A. drylands). It reviews actions of
   the world community led by UN (1972-92) in response to droughts ana
   famines that menaced the continent of Africa. This included holding the
   UN Conference on Desertification (1977), the elaboration of a
   UN-endorsed plan of action to combat desertification and attempts - with
   limited success - at its implementation. World action in 1999 (UNCED)
   and in subsequent years (elaboration of an international convention on
   desertification, June 1994) is described.},
