@article{ WOS:000722925000011,
Author = {Singh, Shivendra and Quarni, Waise and Goralski, Maria and Wan, Shibiao
   and Jin, Hongjian and Van de Velde, Lee-Ann and Fang, Jie and Wu, Qiong
   and Abu-Zaid, Ahmed and Wang, Tingting and Singh, Ravi and Craft, David
   and Fan, Yiping and Confer, Thomas and Johnson, Melissa and Akers,
   Walter J. and Wang, Ruoning and Murray, Peter J. and Thomas, Paul G. and
   Nijhawan, Deepak and Davidoff, Andrew M. and Yang, Jun},
Title = {Targeting the spliceosome through RBM39 degradation results in
   exceptional responses in high-risk neuroblastoma models},
Journal = {SCIENCE ADVANCES},
Year = {2021},
Volume = {7},
Number = {47},
Month = {NOV},
Abstract = {Aberrant alternative pre-mRNA splicing plays a critical role in
   MYC-driven cancers and therefore may represent a therapeutic
   vulnerability. Here, we show that neuroblastoma, a MYC-driven cancer
   characterized by splicing dysregulation and spliceosomal dependency,
   requires the splicing factor RBM39 for survival. Indisulam, a
   ``molecular glue{''}that selectively recruits RBM39 to the CRL4-DCAF15
   E3 ubiquitin ligase for proteasomal degradation, is highly efficacious
   against neuroblastoma, leading to significant responses in multiple
   high-risk disease models, without overt toxicity. Genetic depletion or
   indisulam-mediated degradation of RBM39 induces significant genome-wide
   splicing anomalies and cell death. Mechanistically, the dependency on
   RBM39 and high-level expression of DCAF15 determine the exquisite
   sensitivity of neuroblastoma to indisulam. Our data indicate that
   targeting the dysregulated spliceosome by precisely inhibiting RBM39, a
   vulnerability in neuroblastoma, is a valid therapeutic strategy.},
