@article{ WOS:000074789600002,
Author = {de Soyza, AG and Whitford, WG and Herrick, JE and Van Zee, JW and
   Havstad, KM},
Title = {Early warning indicators of desertification: examples of tests in the
   Chihuahuan Desert},
Journal = {JOURNAL OF ARID ENVIRONMENTS},
