@article{ WOS:A1981ME38100009,
Author = {LAMONT, BB and FOX, JED},
Title = {SPATIAL PATTERN OF 6 SYMPATRIC LEAF VARIANTS AND 2 SIZE CLASSES OF
   ACACIA-ANEURA IN A SEMI-ARID REGION OF WESTERN-AUSTRALIA},
Journal = {OIKOS},
Year = {1981},
Volume = {37},
Number = {1},
Pages = {73-79},
Abstract = {The broad leaf variant of A. aneura was the most abundant of 6 forms in
   the 4000 m2 study site, with plants of each form < 3 m high much more
   abundant than those > 3 m high. The terete form was the only one not
   possessing 9-18 m2-sized patches of uniformly-spaced seedlings, possibly
   because it is preferentially grazed by herbivores. Plants < 3 m high of
   the other forms also showed, on the basis of Morisita''s Index of
   Dispersion, patch sizes at 36-72 m2 and 288-586 m2, with random to
   contagious intraclump distribution. The trees possessed larger, and at
   most 2, scales of pattern, with marked uniformity within the patches
   (except the broadest form) or uniformity without clumping. The effects
   of drought and selective grazing over time may have contributed to the
   different spatial patterns of the trees and shrubs. Considerable
   overlapping of the various forms, especially at higher scales, confirmed
   that their distributions were not tied to habitat differences.},
