@article{ WOS:A1990DM89500010,
Author = {HOFFMAN, MT and COWLING, RM},
Title = {DESERTIFICATION IN THE LOWER SUNDAYS RIVER VALLEY, SOUTH-AFRICA},
Journal = {JOURNAL OF ARID ENVIRONMENTS},
Year = {1990},
Volume = {19},
Number = {1},
Pages = {105-117},
Month = {JUL},
Abstract = {Extensive desertification, over the next 100 years, has been predicted
   for the eastern poarts of SOuth Africa. Using multivariate
   classification and ordination techniques for data from the lower Sundays
   River Valley, eastern Cape, we provide supporting evidence for a limited
   expansion of karroid shrublands into adjacent succulent sub-tropical
   thicket. Karroid shrublands appear more resilient to sustained grazing
   pressure than do the more mesic sub-tropical thicket vegetation types.},
