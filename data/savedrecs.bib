   Chen, Yan, Minist Nat Resources, Land Consolidat \& Rehabil Ctr, Beijing 100035, Peoples R China.
   Guan, Yang, Chinese Acad Environm Planning, Beijing 100012, Peoples R China.},
DOI = {10.1016/j.ecolind.2020.106203},
