@article{ WOS:000452575900009,
Author = {Foronda, Ana and Pueyo, Yolanda and Arroyo, Antonio I. and Saiz, Hugo
   and de la Luz Giner, Maria and Alados, Concepcion L.},
Title = {The role of nurse shrubs on the spatial patterning of plant
   establishment in semi-arid gypsum plant communities},
Journal = {JOURNAL OF ARID ENVIRONMENTS},
Year = {2019},
Volume = {160},
Pages = {82-90},
Month = {JAN},
Abstract = {Plants may depend on nurse plants to establish and survive on gypsum
   environments, which are stressful for plant life. Shrubs may act as
   nurse plants by ameliorating micro-environmental conditions in their
   local vicinity. Despite its importance, the role of nurse shrubs on the
   spatial patterning of plant establishment remains largely unknown in
   gypsum communities. Our aim was to understand the patterns of plant
   establishment and to identify key nurse species in facilitating plant
   establishment and structuring plant diversity at community level in
   these environments. We set an observational study in two gypsum plant
   communities of NE Spain to assess the microsites where seedlings
   germinate. Also, we assessed the role of six dominant shrubs
   (gypsophytes and gypsovags), in spatially structuring plant diversity by
   assessing species-area relationships in their local vicinity to identify
   key nurse species. To assess the potential amelioration of
   micro-environmental conditions associated to shrubs, we analyzed
   physical-chemical soil properties under shrub canopies compared to open
   areas. Most plants were spatially associated with adult shrubs.
   Gypsophytes accumulated more diversity than gypsovags, despite both
   showing ameliorated conditions under canopy compared to open areas. In
   conclusion, gypsophyte shrubs play key roles in the structure of gypsum
   plant communities by facilitating plant establishment.},
