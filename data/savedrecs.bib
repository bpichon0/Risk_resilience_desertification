@article{ WOS:000452692600117,
Author = {Wang, Yun and Lehnert, Lukas W. and Holzapfel, Maika and Schultz, Roland
   and Heberling, Gwendolyn and Goerzen, Eugen and Meyer, Hanna and Seeber,
   Elke and Pinkert, Stefan and Ritz, Markus and Fu, Yao and Ansorge,
   Hermann and Bendix, Joerg and Seifert, Bernhard and Miehe, Georg and
