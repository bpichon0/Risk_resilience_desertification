@article{ WOS:000246369800027,
Author = {Reynolds, James F. and Stafford Smith, D. Mark and Lambin, Eric F. and
   Turner, B. L. and Mortimore, Michael and Batterbury, Simon P. J. and
   Downing, Thomas E. and Dowlatabadi, Hadi and Fernandez, Roberto J. and
   Herrick, Jeffrey E. and Huber-Sannwald, Elisabeth and Jiang, Hong and
   Leemans, Rik and Lynam, Tim and Maestre, Fernando T. and Ayarza, Miguel
   and Walker, Brian},
Title = {Global desertification:: Building a science for dryland development},
Journal = {SCIENCE},
Year = {2007},
Volume = {316},
Number = {5826},
Pages = {847-851},
Month = {MAY 11},
Abstract = {In this millennium, global drylands face a myriad of problems that
   present tough research, management, and policy challenges. Recent
   advances in dryland development, however, together with the integrative
   approaches of global change and sustainability science, suggest that
   concerns about land degradation, poverty, safeguarding biodiversity, and
   protecting the culture of 2.5 billion people can be confronted with
   renewed optimism. We review recent lessons about the functioning of
   dryland ecosystems and the livelihood systems of their human residents
   and introduce a new synthetic framework, the Drylands Development
   Paradigm (DDP). The DDP, supported by a growing and well-documented set
   of tools for policy and management action, helps navigate the inherent
   complexity of desertification and dryland development, identifying and
   synthesizing those factors important to research, management, and policy
   communities.},
